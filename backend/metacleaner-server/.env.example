# Server configuration
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# File processing limits
MAX_FILE_SIZE=524288000
RETENTION_PERIOD=1h
TEMP_STORAGE_PATH=/tmp/metacleaner

# Supabase configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Auth callback URLs
OAUTH_CALLBACK_URL=https://your-domain.fly.dev/api/auth/oauth/callback
MAGIC_LINK_CALLBACK_URL=https://your-domain.fly.dev/api/auth/magic-link/callback
FRONTEND_URL=https://your-domain.fly.dev

# Rate limiting
RATE_LIMIT_RPM=10
