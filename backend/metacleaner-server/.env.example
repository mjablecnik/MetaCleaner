# Server configuration
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Application environment (production → JSON logs at Info level; development → text logs at Debug level)
APP_ENV=development

# File processing limits
MAX_FILE_SIZE=524288000
TEMP_STORAGE_PATH=/tmp/metacleaner

# Supabase configuration (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# DEPRECATED: Legacy HS256 JWT validation. Not used on stage/prod (ES256 via JWKS is used instead).
# Will be removed in a future version. Only needed for local development with older Supabase setups.
SUPABASE_JWT_SECRET=
# Timeout in seconds for outbound Supabase HTTP calls (default: 10)
SUPABASE_TIMEOUT=10

# Auth callback URLs
OAUTH_CALLBACK_URL=https://your-domain.fly.dev/api/auth/oauth/callback
MAGIC_LINK_CALLBACK_URL=https://your-domain.fly.dev/api/auth/magic-link/callback
FRONTEND_URL=https://your-domain.fly.dev

# Rate limiting
RATE_LIMIT_RPM=60

# Mobile deep link configuration (optional — used by /.well-known endpoints)
# SHA-256 fingerprint of the Android signing certificate (colon-separated hex pairs)
ANDROID_CERT_FINGERPRINT=AA:BB:CC:...
# Apple Developer Team ID (10-character alphanumeric string)
APPLE_TEAM_ID=XXXXXXXXXX

# Stripe configuration (required for billing endpoints)
# Use sk_test_* keys for local development, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Webhook secret from `stripe listen` output (whsec_*) for local dev,
# or from the Stripe dashboard for production
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Stripe Price IDs — find these in the Stripe dashboard under Products
# Use test-mode price IDs (price_test_*) for local development
STRIPE_PRICE_PRO_MONTH=price_your-pro-monthly-price-id
STRIPE_PRICE_PRO_YEAR=price_your-pro-yearly-price-id
STRIPE_PRICE_PROPLUS_MONTH=price_your-proplus-monthly-price-id
STRIPE_PRICE_PROPLUS_YEAR=price_your-proplus-yearly-price-id
STRIPE_PRICE_CREDIT_PACK=price_your-credit-pack-price-id

# Brevo (email sending for email change verification)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@metacleaner.app

# Tigris object storage (cleaned files). Leave TIGRIS_ENDPOINT set to an empty
# value to disable Tigris and keep cleaned files on local disk (local dev default).
TIGRIS_ACCESS_KEY=your-tigris-access-key
TIGRIS_SECRET_KEY=your-tigris-secret-key
TIGRIS_BUCKET=metacleaner-files
TIGRIS_ENDPOINT=
# Expiry for presigned download URLs. Go duration format: 1h, 30m
TIGRIS_PRESIGN_EXPIRY=1h
