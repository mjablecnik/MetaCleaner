# MetaCleaner Monitoring — Environment Variables

# Server Configuration
NODE_ENV=production
PORT=3000

# Supabase (monitoring data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# Fly.io (machine/app metrics)
FLY_API_TOKEN=your-fly-api-token-here

# Cloudflare (DNS/CDN analytics)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ZONE_ID=your-zone-id-here

# Sentry (error tracking)
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here
SENTRY_ORG=your-sentry-org-here
SENTRY_PROJECT=your-sentry-project-here

# Stripe (billing)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here
