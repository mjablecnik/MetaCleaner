# MetaCleaner Web — Environment Variables

# Supabase (required for contact form)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Function secrets (deployed via scripts/deploy-functions.sh)
BREVO_API_KEY=your-brevo-api-key-here
# CONTACT_RECIPIENT=hello@metacleaner.app
# CONTACT_SENDER_EMAIL=noreply@metacleaner.app
# ALLOWED_ORIGINS=https://metacleaner.app,https://www.metacleaner.app
