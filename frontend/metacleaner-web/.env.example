# MetaCleaner Web — Environment Variables

# Brevo transactional email API key (required for contact form)
VITE_BREVO_API_KEY=

# Optional: override the default recipient for contact form emails
# VITE_BREVO_RECIPIENT=hello@metacleaner.app

# App URL for CTA redirects from the pricing page (required for plan selection)
# Development: http://localhost:5174  (or wherever metacleaner-app is running)
# Production:  https://app.metacleaner.com
PUBLIC_APP_URL=http://localhost:5174
